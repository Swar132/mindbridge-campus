{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/frontend/dist/icons/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/frontend/dist/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/frontend/dist/sw.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ]
}
